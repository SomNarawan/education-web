# The base-path rewrite and service name placeholders below are filled in by Dockerfile.private / Dockerfile.public.
# /etc/nginx/api-proxy/ is filled in at container start by docker/nginx/40-api-proxy.sh.

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

server {
    # 80: docker-compose.yml (local dev), 3008: staff site, 3007: student site.
    listen 80;
    listen 3007;
    listen 3008;
    server_name _;
    root /usr/share/nginx/html;

    # Drop the base path when the reverse proxy passes it through, so files are
    # found the same way whether or not the proxy strips it.
    __BASE_PATH_REWRITE__

    # Same-origin API proxy (student site only - empty unless API_UPSTREAM is set).
    include /etc/nginx/api-proxy/*.conf;

    # Liveness of this container only (Docker HEALTHCHECK, the API's /api/health).
    location = /healthz {
        access_log off;
        default_type application/json;
        charset utf-8;
        charset_types application/json;
        return 200 '{"status":"ok","service":"__SERVICE__","message":"__SERVICE__ (nginx) ทำงานปกติ - ตรวจเฉพาะ container นี้"}\n';
    }

    location / {
        try_files $uri /index.html;
    }

    # Hashed build assets never change - cache them hard.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Always revalidate the entry page so a new deploy is picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
