# syntax=docker/dockerfile:1

# Staff site (admin/teacher) - office.eng.kps.ku.ac.th, port 3008.
# Built by ../education-api/docker-compose.yml (service web) and, for local
# development, by docker-compose.yml here. The student site is Dockerfile.public.
#
# VITE_* build args are baked in at build time - rebuild after changing them.
# The site answers both with and without its base path in the URL, so it works
# whether or not the reverse proxy strips the prefix. The browser calls the API
# directly (VITE_API_URL), so nothing is proxied here.

# ---- build ----
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG VITE_API_URL
ARG VITE_MOCK_LOGIN_ENABLED=false
ARG VITE_BASE_PATH=
ARG VITE_AUTH_PROVIDER
ARG VITE_PORTAL_LOGIN_URL
ARG VITE_PORTAL_LOGOUT_URL
ENV VITE_API_URL=$VITE_API_URL \
    VITE_MOCK_LOGIN_ENABLED=$VITE_MOCK_LOGIN_ENABLED \
    VITE_BASE_PATH=$VITE_BASE_PATH \
    VITE_APP_MODE=staff \
    VITE_AUTH_PROVIDER=$VITE_AUTH_PROVIDER \
    VITE_PORTAL_LOGIN_URL=$VITE_PORTAL_LOGIN_URL \
    VITE_PORTAL_LOGOUT_URL=$VITE_PORTAL_LOGOUT_URL

# The base path is read back from the built index.html, so the nginx config
# always matches what was actually built.
RUN npm run build \
    && base="$(sed -n 's#.*src="\([^"]*\)/assets/.*#\1#p' dist/index.html | head -n 1)" \
    && if [ -n "$base" ]; then rewrite="rewrite ^${base}(?:/(.*))?\$ /\$1 last;"; else rewrite=""; fi \
    && sed -e "s#__BASE_PATH_REWRITE__#${rewrite}#" -e "s#__SERVICE__#web#g" \
           docker/nginx/default.conf.template > dist.nginx.conf

# ---- runtime ----
FROM nginx:1.27-alpine

COPY --from=build /app/dist.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# The nginx config includes /etc/nginx/api-proxy/*.conf - left empty here.
RUN mkdir -p /etc/nginx/api-proxy

# 80: docker-compose.yml (local dev), 3008: the server.
EXPOSE 80 3008

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO /dev/null http://127.0.0.1/healthz || exit 1
