# Production student site (Dockerfile.public). Copy to .env.public.
VITE_API_URL=/kukps-eng-education-ssd-public/api
VITE_BASE_PATH=/kukps-eng-education-ssd-public
VITE_APP_MODE=student
# Students sign in through mock login until they have a real login.
VITE_AUTH_PROVIDER=mock
VITE_MOCK_LOGIN_ENABLED=false
# Run time, not build time: where nginx forwards /api/* to.
API_UPSTREAM=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api
