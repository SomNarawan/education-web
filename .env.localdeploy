# Local deploy test of the student site - start the education-api stack first
# (its .env.docker), then:
#
#   docker compose -f docker-compose.public.yml --env-file .env.localdeploy up -d --build
#
# Open http://localhost:3007/kukps-eng-education-ssd-public/

# The api on this machine instead of office.eng.kps.ku.ac.th.
WEB_PUBLIC_API_UPSTREAM=http://host.docker.internal:3009
WEB_PUBLIC_MOCK_LOGIN_ENABLED=true
WEB_PUBLIC_EXTERNAL_PORT=3007
